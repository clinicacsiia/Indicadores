# Copie para .env.local (desenvolvimento) ou cadastre nas variáveis de ambiente da Vercel. Nunca coloque valores aqui.

# Vão ao navegador (são públicas por desenho; a proteção está nas políticas RLS):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOMENTE servidor (nunca com prefixo NEXT_PUBLIC_):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
KLINGO_APP_TOKEN=
# Segredo das rotas /api/cron/* e da chamada interna ao cálculo em Python. Gere um valor longo e aleatório (openssl rand -hex 32).
CRON_SECRET=
